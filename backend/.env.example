# Public MQTT broker reachable by both the ESP32-S3 and Render.
MQTT_HOST=broker.example.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID=edge-iot-backend
# Optional custom CA file. Leave empty for a public CA.
MQTT_CA_FILE=
DASHBOARD_ORIGINS=https://edge-iot-project-2.onrender.com
# For optional HTTPS ingest; MQTT works without this.
DEVICE_API_KEY=
# Use a persistent database in production, e.g. a Render Postgres URL.
DATABASE_URL=sqlite:///./iot_data.db
